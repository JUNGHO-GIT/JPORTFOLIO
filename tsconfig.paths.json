{
  "$schema": "http://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "out",
    "paths": {
      "@assets/*": ["src/assets/*"],
			"@type/*": ["src/assets/type/domain/*"],
      "@scripts/*": ["src/assets/scripts/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@repositories/*": ["src/repositories/*"],
      "@routers/*": ["src/routers/*"],
      "@schemas/*": ["src/schemas/*"],
      "@services/*": ["src/services/*"],
    },
    "typeRoots": [
			"node_modules/@types",
			"src/assets/type/dist"
    ],
    "types": [
      "node",
      "alias",
      "extension",
    ],
  },
  "include": [
    "index.ts",
    "src/**/*",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "**/*.js",
    "**/*.jsx",
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
  ],
}