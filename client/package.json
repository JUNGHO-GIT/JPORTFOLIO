{
  "name": "jportfolio-client",
  "homepage": "/JPORTFOLIO",
  "version": "1.0.0",
  "type": "module",
  "main": "index.tsx",
  "license": "Apache-2.0",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "import/extensions": "off",
      "import/prefer-default-export": "off",
      "no-console": "off",
      "no-underscore-dangle": "off",
      "no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "react-hooks/rules-of-hooks": "warn",
      "@typescript-eslint/no-unused-expressions": "off",
      "@typescript-eslint/no-unused-vars": [
        "off",
        {
          "varsIgnorePattern": "^_",
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "16.x"
  },
  "overrides": {
    "webidl-conversions": "8.0.1",
    "whatwg-url": "16.0.1"
  },
  "scripts": {
    "git": "bun ~/.bootstrap/bootstrap-sync.mjs --git",
    "sync": "bun ~/.bootstrap/bootstrap-sync.mjs --sync",
    "tools": "bun ~/.bootstrap/bootstrap-sync.mjs --tools"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@emotion/utils": "^1.4.2",
    "@mui/material": "^9.0.0",
    "@mui/system": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.2",
    "@react-hooks-library/core": "^0.6.2",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.15.0",
    "countries-and-timezones": "^3.9.0",
    "date-fns": "^4.1.0",
    "iso-country-currency": "^0.7.2",
    "material-ui-popup-state": "^5.3.7",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.1",
    "mui-file-input": "^8.0.1",
    "react": "^19.2.5",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1",
    "react-scripts": "^5.0.1",
    "recharts": "^3.8.1",
    "swiper": "^12.1.3",
    "typed.js": "^3.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@mui/types": "^9.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.26",
    "@swc/helpers": "0.5.21",
    "@testing-library/react": "^16.3.2",
    "@types/navermaps": "^3.9.1",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router": "^5.1.20",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "esbuild": "0.28.1",
    "globals": "17.5.0",
    "ts-morph": "28.0.0",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "typescript": "6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-compression": "^0.5.1"
  }
}
