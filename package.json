{
  "name": "jportfolio-server",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "license": "Apache-2.0",
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "import/extensions": "off",
      "import/prefer-default-export": "off",
      "no-console": "off",
      "no-underscore-dangle": "off",
      "no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "react-hooks/rules-of-hooks": "warn",
      "@typescript-eslint/no-unused-vars": [
        "off",
        {
          "varsIgnorePattern": "^_",
          "argsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-unused-expressions": "off"
    }
  },
  "engines": {
    "node": "16.x"
  },
  "overrides": {
    "webidl-conversions": "8.0.1",
    "whatwg-url": "16.0.1"
  },
  "scripts": {
    "git": "bun ~/.bootstrap/bootstrap-sync.mjs --git",
    "sync": "bun ~/.bootstrap/bootstrap-sync.mjs --sync",
    "tools": "bun ~/.bootstrap/bootstrap-sync.mjs --tools"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "moment-timezone": "^0.6.1",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "node-fetch": "3.3.2",
    "nodemailer": "^8.0.5",
    "oauth-signature": "^1.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qs": "^6.15.1",
    "request-promise": "^4.2.6",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.26",
    "@swc/helpers": "0.5.21",
    "@types/cors": "^2.8.19",
    "@types/eslint": "9.6.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsdom": "^28.0.1",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/qs": "^6.15.0",
    "@types/swiper": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "esbuild": "0.28.0",
    "eslint": "10.2.1",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.5.0",
    "jsdom": "^29.0.2",
    "ts-morph": "28.0.0",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2"
  }
}
