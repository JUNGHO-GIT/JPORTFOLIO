{
  "name": "jportfolio-server",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "license": "Apache-2.0",
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "import/extensions": "off",
      "import/prefer-default-export": "off",
      "no-console": "off",
      "no-underscore-dangle": "off",
      "no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "react-hooks/rules-of-hooks": "warn",
      "@typescript-eslint/no-unused-vars": [
        "off",
        {
          "varsIgnorePattern": "^_",
          "argsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-unused-expressions": "off"
    }
  },
  "engines": {
    "node": "16.x"
  },
  "overrides": {
    "webidl-conversions": "6.1.0",
    "whatwg-url": "12.0.1"
  },
  "scripts": {
    "sync": "bun .node/mjs/sync.mjs --bun --sync --server",
    "start": "bun .node/mjs/swc.mjs --bun --start --server",
    "build": "bun .node/mjs/swc.mjs --bun --build --server",
    "fix": "bun .node/mjs/fix.mjs --bun --fix",
    "reset": "bun .node/mjs/reset.mjs --bun --reset",
    "vsce": "bun .node/mjs/vsce.mjs --bun --package",
    "gcloud": "bun .node/mjs/gcloud.mjs --bun --server",
    "git-push-y": "bun .node/mjs/git.mjs --bun --push --y",
    "git-push-n": "bun .node/mjs/git.mjs --bun --push --n"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.18.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "moment-timezone": "^0.6.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "3.3.2",
    "nodemailer": "^7.0.12",
    "oauth-signature": "^1.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qs": "^6.14.0",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.6.1",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.7",
    "@swc/helpers": "0.5.18",
    "@types/cors": "^2.8.19",
    "@types/eslint": "9.6.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/qs": "^6.14.0",
    "@types/swiper": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-plugin-html": "8.1.3",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "16.5.0",
    "jsdom": "^27.4.0",
    "ts-morph": "27.0.2",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1"
  }
}
